{{- /*
  Let's Encrypt host list, generated by rancher-gen and *parsed* (never sourced)
  by /app/letsencrypt.sh. One tab-separated record per certificate:

      id <TAB> hosts (";"-separated, first one names the certificate) <TAB> email <TAB> test

  Every field is validated again in letsencrypt.sh before it reaches certbot.
*/ -}}
{{- $default_email := or (env "DEFAULT_EMAIL") "" -}}
# id	hosts	email	test
{{ range $host, $services := services | groupByMulti "rap.le_host" "," -}}
{{- $first := first $services -}}
{{ formatClean $host }}	{{ $host }}	{{ $first.Labels.GetValue "rap.le_email" $default_email }}	{{ $first.Labels.GetValue "rap.le_test" "false" }}
{{ end -}}
{{- range $host, $conts := host.Containers | groupByMultiFilter "" "rap.le_host" "," -}}
{{- $first := first $conts -}}
{{ formatClean $host }}	{{ $host }}	{{ $first.Labels.GetValue "rap.le_email" $default_email }}	{{ $first.Labels.GetValue "rap.le_test" "false" }}
{{ end -}}
