#!/bin/bash
# Remove a Let's Encrypt certificate (and nginx links) for one host, or
# everything with '*'. Usage: docker exec <proxy> /app/remove <certname|*>
set -u
source /app/functions.sh

name="${1:-}"

if [[ -z "$name" ]]; then
    echo "Usage: $0 <certificate name | *>" >&2
    echo "Nothing to delete. Pass a certificate name (the first rap.le_host of the service) or '*' for all." >&2
    exit 1
fi

if [[ "$name" == "*" ]]; then
    log "Deleting ALL certificates"
    rm -rf "${LE_DIR}/archive"/* "${LE_DIR}/live"/* "${LE_DIR}/renewal"/*
    find "$CERT_DIR" -maxdepth 1 -type l ! -name 'default.*' -delete
elif is_safe_name "$name"; then
    log "Deleting certificate '$name'"
    certbot delete --non-interactive --cert-name "$name" 2>/dev/null \
        || rm -rf "${LE_DIR}/archive/${name}" "${LE_DIR}/live/${name}" "${LE_DIR}/renewal/${name}.conf"
    # Drop every nginx link that pointed at this lineage (plus the matching dhparam links).
    while IFS= read -r link; do
        rm -f "$link" "${link%.*}.dhparam.pem"
    done < <(find "$CERT_DIR" -maxdepth 1 -type l -lname "${LE_DIR}/live/${name}/*")
else
    err "'$name' is not a valid certificate name"
    exit 1
fi

# Regenerate the nginx configuration without the deleted certificate(s).
reload_nginx
