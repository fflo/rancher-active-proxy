{{/*
  nginx configuration generated by rancher-gen from the Rancher metadata service.

  Every value that comes from a container label is validated (isHostname, isPort,
  isSafeToken, isRate, ...) before it is written into a directive, so a tenant who
  can set labels on a service cannot inject nginx configuration into the proxy.

  Protection knobs (environment = proxy-wide default, label = per rap.host):
    RATE_LIMIT / rap.rate_limit      requests per client IP, e.g. "30r/s", "600r/m" or "off"
    RATE_BURST / rap.rate_burst      burst allowance before 429 is returned
    CONN_LIMIT / rap.conn_limit      concurrent connections per client IP, or "off"
    WAF        / rap.waf             ModSecurity + OWASP CRS: "on", "detect" (log only) or "off"
    SECURITY_HEADERS / rap.security_headers   "on" or "off"
    REAL_IP_FROM                     comma-separated CIDRs of upstream proxies / CDNs that are
                                     trusted to set X-Forwarded-For (rate limits key on it)
*/ -}}

{{ define "upstream" }}
{{- if not .FIRST.Get -}}
	upstream {{.HOST}} {
{{- end -}}
{{ if .ONLINE }}
	# Access through rancher managed network
	server {{.IP}}:{{.PORT}};
{{- else }}
	# {{.IP}} is not running or is unhealthy
{{- end }}
{{ end }}

{{ define "acme_location" }}
	location ^~ /.well-known/acme-challenge/ {
		{{- if .WAF }}
		modsecurity off;
		{{- end }}
		{{- if .LE_BYPASS }}
		proxy_pass http://{{ .HOST }}$request_uri;
		{{- else }}
		root /usr/share/nginx/html;
		default_type "text/plain";
		try_files $uri =404;
		{{- end }}
	}
{{- end }}

{{ define "tls" }}
	ssl_certificate /etc/nginx/certs/{{ .CERT }}.crt;
	ssl_certificate_key /etc/nginx/certs/{{ .CERT }}.key;
	{{- if (exists (printf "/etc/nginx/certs/%s.dhparam.pem" .CERT)) }}
	ssl_dhparam /etc/nginx/certs/{{ .CERT }}.dhparam.pem;
	{{- end }}

	# Mozilla "intermediate" profile (TLS 1.2 + 1.3, AEAD ciphers only, forward secrecy)
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers off;
	ssl_ecdh_curve X25519:prime256v1:secp384r1;
	ssl_session_timeout 1d;
	ssl_session_cache shared:SSL:10m;
	ssl_session_tickets off;
{{- end }}

{{ define "protection" }}
	{{- if ne .RATE "off" }}
	limit_req zone=rap_req_{{ replace .RATE "/" "_" -1 }} burst={{ .BURST }} nodelay;
	{{- end }}
	{{- if ne .CONN "off" }}
	limit_conn rap_conn {{ .CONN }};
	{{- end }}
	{{- if ne .WAF "off" }}
	modsecurity on;
	{{- if eq .WAF "detect" }}
	modsecurity_rules 'SecRuleEngine DetectionOnly';
	{{- end }}
	{{- if (exists (printf "/etc/nginx/vhost.d/%s_modsec" .HOST)) }}
	modsecurity_rules_file /etc/nginx/vhost.d/{{ .HOST }}_modsec;
	{{- end }}
	{{- end }}
	{{- if ne .HEADERS "off" }}
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	{{- end }}
{{- end }}

{{ define "proxy_location" }}
	location / {
		{{- if eq .PROTO "uwsgi" }}
		include uwsgi_params;
		uwsgi_pass uwsgi://{{ .HOST }};
		{{- if .TIMEOUT }}
		uwsgi_read_timeout {{ .TIMEOUT }}s;
		{{- end }}
		{{- else }}
		proxy_pass {{ .PROTO }}://{{ .HOST }};
		{{- if .TIMEOUT }}
		proxy_read_timeout {{ .TIMEOUT }}s;
		{{- end }}
		{{- end }}
		{{- if (exists (printf "/etc/nginx/htpasswd/%s" .HOST)) }}
		auth_basic "Restricted {{ .HOST }}";
		auth_basic_user_file /etc/nginx/htpasswd/{{ .HOST }};
		{{- else if (exists "/etc/nginx/htpasswd/default") }}
		auth_basic "Restricted {{ .HOST }}";
		auth_basic_user_file /etc/nginx/htpasswd/default;
		{{- end }}
		{{- if (exists (printf "/etc/nginx/vhost.d/%s_location" .HOST)) }}
		include /etc/nginx/vhost.d/{{ .HOST }}_location;
		{{- else if (exists "/etc/nginx/vhost.d/default_location") }}
		include /etc/nginx/vhost.d/default_location;
		{{- end }}
	}
{{- end }}

{{ define "server" }}

{{ $host := .HOST -}}
{{- if (exists (printf "/etc/nginx/vhost.d/%s_server" $host)) }}
include /etc/nginx/vhost.d/{{ $host }}_server;
{{- else if (exists "/etc/nginx/vhost.d/default_server") }}
include /etc/nginx/vhost.d/default_server;
{{- else }}

{{- $http_ports := split (.FIRST.Labels.GetValue "rap.http_listen_ports" "80") "," }}
{{- $https_ports := split (.FIRST.Labels.GetValue "rap.https_listen_ports" "443") "," }}

{{- $default_host := or (env "DEFAULT_HOST") "" }}
{{- $default_server := index (dict $host "" $default_host "default_server") $host }}

{{- $proto := .FIRST.Labels.GetValue "rap.proto" "http" | or .PROTO }}
{{- if not (isSafeToken $proto) }}{{ $proto = "http" }}{{ end }}
{{- $https_method := .FIRST.Labels.GetValue "rap.https_method" "redirect" }}
{{- $hsts := .FIRST.Labels.GetValue "rap.hsts" "" }}

{{- $vhostCert := (closest (dirList "/etc/nginx/certs") (printf "%s.crt" $host)) }}
{{- $vhostCert := trimSuffix $vhostCert ".crt" }}
{{- $vhostCert := trimSuffix $vhostCert ".key" }}

{{- $cert := .FIRST.Labels.GetValue "rap.cert_name" $vhostCert }}
{{- if not (isSafeToken $cert) }}{{ $cert = "" }}{{ end }}
{{- $token := .FIRST.Labels.GetValue "rap.server_tokens" "" }}
{{- if not (isSafeToken $token) }}{{ $token = "" }}{{ end }}
{{- $body_size := .FIRST.Labels.GetValue "rap.client_max_body_size" "" }}
{{- if not (isSafeToken $body_size) }}{{ $body_size = "" }}{{ end }}
{{- $le_bypass := .FIRST.Labels.GetValue "rap.le_bypass" "" }}
{{- $timeout := .FIRST.Labels.GetValue "rap.timeout" "" }}
{{- if not (isNumber $timeout) }}{{ $timeout = "" }}{{ end }}

{{- /* flood / WAF / header settings: label overrides proxy-wide environment default */}}
{{- /* invalid label values fall back to the proxy-wide default, never to "off" */}}
{{- $rate_default := or (env "RATE_LIMIT") "30r/s" }}
{{- if not (isRate $rate_default) }}{{ $rate_default = "off" }}{{ end }}
{{- $rate := .FIRST.Labels.GetValue "rap.rate_limit" $rate_default }}
{{- if and (ne $rate "off") (not (isRate $rate)) }}{{ $rate = $rate_default }}{{ end }}
{{- $burst_default := or (env "RATE_BURST") "60" }}
{{- if not (isNumber $burst_default) }}{{ $burst_default = "60" }}{{ end }}
{{- $burst := .FIRST.Labels.GetValue "rap.rate_burst" $burst_default }}
{{- if not (isNumber $burst) }}{{ $burst = $burst_default }}{{ end }}
{{- $conn_default := or (env "CONN_LIMIT") "100" }}
{{- if and (ne $conn_default "off") (not (isNumber $conn_default)) }}{{ $conn_default = "100" }}{{ end }}
{{- $conn := .FIRST.Labels.GetValue "rap.conn_limit" $conn_default }}
{{- if and (ne $conn "off") (not (isNumber $conn)) }}{{ $conn = $conn_default }}{{ end }}
{{- $waf_global := or (env "WAF") "detect" }}
{{- if and (ne $waf_global "on") (ne $waf_global "off") }}{{ $waf_global = "detect" }}{{ end }}
{{- $waf := .FIRST.Labels.GetValue "rap.waf" $waf_global }}
{{- if and (ne $waf "on") (ne $waf "detect") (ne $waf "off") }}{{ $waf = $waf_global }}{{ end }}
{{- if eq $waf_global "off" }}{{ $waf = "off" }}{{ end }}
{{- $headers := .FIRST.Labels.GetValue "rap.security_headers" (or (env "SECURITY_HEADERS") "on") }}
{{- $prot := dict "HOST" $host "RATE" $rate "BURST" $burst "CONN" $conn "WAF" $waf "HEADERS" $headers }}
{{- $acme := dict "HOST" $host "LE_BYPASS" $le_bypass "WAF" (ne $waf "off") }}

{{- $is_https := (and (ne $https_method "nohttps") (ne $cert "") (exists (printf "/etc/nginx/certs/%s.crt" $cert)) (exists (printf "/etc/nginx/certs/%s.key" $cert))) }}
{{- $https_port := first $https_ports }}
{{- $redirect_target := when (eq $https_port "443") (printf "https://%s$request_uri" $host) (printf "https://%s:%s$request_uri" $host $https_port) }}

{{- if $is_https }}

{{- if eq $https_method "redirect" }}
server {
	server_name {{ $host }};
	{{- range $port := $http_ports }}
	{{- if isPort $port }}
	listen {{ $port }} {{ $default_server }};
	{{- end }}
	{{- end }}
	{{- if (ne $token "") }}
	server_tokens {{ $token }};
	{{- end }}
	{{- if (ne $body_size "") }}
	client_max_body_size {{ $body_size }};
	{{- end }}
	access_log /var/log/nginx/access.log vhost;
	{{- template "acme_location" $acme }}
	location / {
		return 301 {{ $redirect_target }};
	}
}
{{- end }}

server {
	server_name {{ $host }};
	{{- range $port := $https_ports }}
	{{- if isPort $port }}
	listen {{ $port }} ssl {{ $default_server }};
	{{- end }}
	{{- end }}
	http2 on;
	access_log /var/log/nginx/access.log vhost;

	{{- if (ne $token "") }}
	server_tokens {{ $token }};
	{{- end }}
	{{- if (ne $body_size "") }}
	client_max_body_size {{ $body_size }};
	{{- end }}

	{{- template "tls" (dict "CERT" $cert) }}
	{{- template "protection" $prot }}

	{{- if and (ne $https_method "noredirect") (ne $hsts "off") }}
	{{- if eq $hsts "preload" }}
	add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
	{{- else if eq $hsts "includeSubDomains" }}
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	{{- else }}
	add_header Strict-Transport-Security "max-age=31536000" always;
	{{- end }}
	{{- end }}

	{{- if (exists (printf "/etc/nginx/vhost.d/%s" $host)) }}
	include /etc/nginx/vhost.d/{{ $host }};
	{{- else if (exists "/etc/nginx/vhost.d/default") }}
	include /etc/nginx/vhost.d/default;
	{{- end }}

	{{- template "proxy_location" (dict "HOST" $host "PROTO" $proto "TIMEOUT" $timeout) }}
}

{{ end -}}


{{- if or (not $is_https) (eq $https_method "noredirect") -}}

server {
	server_name {{ $host }};
	{{- range $port := $http_ports }}
	{{- if isPort $port }}
	listen {{ $port }} {{ $default_server }};
	{{- end }}
	{{- end }}
	access_log /var/log/nginx/access.log vhost;

	{{- if (ne $token "") }}
	server_tokens {{ $token }};
	{{- end }}
	{{- if (ne $body_size "") }}
	client_max_body_size {{ $body_size }};
	{{- end }}
	{{- template "protection" $prot }}
	{{- template "acme_location" $acme }}

	{{- if (exists (printf "/etc/nginx/vhost.d/%s" $host)) }}
	include /etc/nginx/vhost.d/{{ $host }};
	{{- else if (exists "/etc/nginx/vhost.d/default") }}
	include /etc/nginx/vhost.d/default;
	{{- end }}

	{{- template "proxy_location" (dict "HOST" $host "PROTO" $proto "TIMEOUT" $timeout) }}
}

{{- if (and (not $is_https) (exists "/etc/nginx/certs/default.crt") (exists "/etc/nginx/certs/default.key")) }}

server {
	server_name {{ $host }};
	{{- range $port := $https_ports }}
	{{- if isPort $port }}
	listen {{ $port }} ssl {{ $default_server }};
	{{- end }}
	{{- end }}
	http2 on;
	access_log /var/log/nginx/access.log vhost;

	{{- if (ne $token "") }}
	server_tokens {{ $token }};
	{{- end }}

	return 503;

	{{- template "tls" (dict "CERT" "default") }}
}
{{- end -}}
{{- end -}}

{{- end -}}
{{- end -}}

# If we receive X-Forwarded-Proto, pass it through; otherwise, pass along the
# scheme used to connect to this server
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
	default $http_x_forwarded_proto;
	''	  $scheme;
}

# If we receive X-Forwarded-Port, pass it through; otherwise, pass along the
# server port the client connected to
map $http_x_forwarded_port $proxy_x_forwarded_port {
	default $http_x_forwarded_port;
	''	  $server_port;
}

# If we receive Upgrade, set Connection to "upgrade"; otherwise, delete any
# Connection header that may have been passed to this server
map $http_upgrade $proxy_connection {
	default upgrade;
	'' close;
}

# Set appropriate X-Forwarded-Ssl header
map $scheme $proxy_x_forwarded_ssl {
	default off;
	https on;
}

gzip_types text/plain text/css application/javascript application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript;

log_format vhost '$host $remote_addr - $remote_user [$time_local] '
				 '"$request" $status $body_bytes_sent '
				 '"$http_referer" "$http_user_agent"';

access_log off;

{{- if (exists "/etc/nginx/proxy.conf") }}
include /etc/nginx/proxy.conf;
{{- else }}

# HTTP 1.1 support
proxy_http_version 1.1;
proxy_buffering off;
proxy_set_header Host $http_host;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $proxy_connection;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
proxy_set_header X-Forwarded-Ssl $proxy_x_forwarded_ssl;
proxy_set_header X-Forwarded-Port $proxy_x_forwarded_port;

# Mitigate httpoxy attack (see README for details)
proxy_set_header Proxy "";
{{- end }}

{{- $http_ports_services := services | getAllLabelValue "*" "rap.http_listen_ports" ","}}
{{- $http_ports_stand := host.Containers | getAllLabelValue "" "rap.http_listen_ports" ","}}
{{- $http_ports := concatenateUnique $http_ports_services $http_ports_stand }}

{{- $https_ports_services := services | getAllLabelValue "*" "rap.https_listen_ports" ","}}
{{- $https_ports_stand := host.Containers | getAllLabelValue "" "rap.https_listen_ports" ","}}
{{- $https_ports := concatenateUnique $https_ports_services $https_ports_stand }}

{{- $acme_internal := or (env "ACME_INTERNAL") "" }}
{{- if not (isSafeToken $acme_internal) }}{{ $acme_internal = "" }}{{ end }}

# --- Flood protection -------------------------------------------------------
# One limit_req zone per distinct rate in use (proxy default + every rap.rate_limit label).
{{- $default_rate := or (env "RATE_LIMIT") "30r/s" }}
{{- if not (isRate $default_rate) }}{{ $default_rate = "" }}{{ end }}
{{- $rates_services := services | getAllLabelValue "*" "rap.rate_limit" "," }}
{{- $rates_stand := host.Containers | getAllLabelValue "" "rap.rate_limit" "," }}
{{- $rates := concatenateUnique (concatenateUnique $rates_services $rates_stand) (split $default_rate ",") }}
{{- range $rate := $rates }}
{{- if isRate $rate }}
limit_req_zone $binary_remote_addr zone=rap_req_{{ replace $rate "/" "_" -1 }}:10m rate={{ $rate }};
{{- end }}
{{- end }}
limit_conn_zone $binary_remote_addr zone=rap_conn:10m;
limit_req_status 429;
limit_conn_status 429;
limit_req_log_level warn;
limit_conn_log_level warn;

{{- $real_ip_from := or (env "REAL_IP_FROM") "" }}
{{- if ne $real_ip_from "" }}
# Trust X-Forwarded-For from these upstream proxies / CDNs so limits apply to the real client.
{{- range $cidr := split $real_ip_from "," }}
{{- $cidr = trim $cidr }}
{{- if isCIDR $cidr }}
set_real_ip_from {{ $cidr }};
{{- else if ne $cidr "" }}
# skipped REAL_IP_FROM entry {{ printf "%q" $cidr }}: not an IP or CIDR
{{- end }}
{{- end }}
real_ip_header X-Forwarded-For;
real_ip_recursive on;
{{- end }}

# --- Web application firewall ----------------------------------------------
{{- $waf_global := or (env "WAF") "detect" }}
{{- if ne $waf_global "off" }}
# ModSecurity + OWASP CRS are loaded once here; each rap.host switches them on, to
# detection-only (rap.waf=detect) or off (rap.waf=off).
modsecurity off;
modsecurity_rules_file /etc/modsecurity.d/setup.conf;
{{- end }}

# Catch-all (first server block = nginx default for the port unless DEFAULT_HOST is set):
# requests for unknown hosts never reach a tenant upstream
server {
	server_name _; # This is just an invalid value which will never trigger on a real hostname.
	listen 80;
	{{- range $port := $http_ports }}
	{{- if and (isPort $port) (ne $port "80") }}
	listen {{ $port }};
	{{- end }}
	{{- end }}
	access_log /var/log/nginx/access.log vhost;
	location / {
		return 503;
	}

	{{- if (ne $acme_internal "") }}
	location /.well-known { # This allows proxy acme requests to pass through to another server.
		proxy_pass http://{{ $acme_internal }}/.well-known;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	}
	{{- end }}
}

{{- if (and (exists "/etc/nginx/certs/default.crt") (exists "/etc/nginx/certs/default.key")) }}
server {
	server_name _; # This is just an invalid value which will never trigger on a real hostname.
	listen 443 ssl;
	{{- range $port := $https_ports }}
	{{- if and (isPort $port) (ne $port "443") }}
	listen {{ $port }} ssl;
	{{- end }}
	{{- end }}
	http2 on;
	access_log /var/log/nginx/access.log vhost;
	return 503;

	{{- template "tls" (dict "CERT" "default") }}
}
{{- end -}}

{{- $default_port := or (env "DEFAULT_PORT") "80" }}
{{- $host_filter := or (env "SPECIFIC_HOST") "*" }}
{{- $rap_name := or (env "RAP_NAME") "*" }}

# Rancher Services config

{{- range $opt, $services := services | groupByMulti "rap.host" ","}}
{{- $parts := split $opt "=>"}}
{{- $host := first $parts | trim }}
{{- $dest := last $parts | trim }}
{{- $destParts := split (when (ne $host $dest) $dest ":") ":" }}
{{- $destProto := first $destParts }}
{{- $destPort := last $destParts }}
{{- if eq (len $destParts) 1 }}{{ $destProto = "" }}{{ end }}{{/* "host=>8080" means port only */}}
{{- if not (isHostname $host) }}
# skipped rap.host value {{ printf "%q" $host }}: not a valid hostname
{{- continue }}
{{- end }}
{{- if and (ne $destPort "") (not (isPort $destPort)) }}
# skipped rap.host value {{ printf "%q" $opt }}: not a valid port
{{- continue }}
{{- end }}
{{- if not (isSafeToken $destProto) }}{{ $destProto = "" }}{{ end }}
{{- $alive := cell false }}
{{- $anyHealthy := cell false }}

{{range $service := $services}}
{{- $addrLen := len $service.Ports }}
{{- range $cont := $service.Containers | filterHost $host_filter | filterLabel "rap.rap_name" $rap_name}}
		{{- $online := (and (or (eq .Health "") (eq .Health "healthy")) (eq .State "running")) -}}
		{{- if $online }}
			{{- $_ := $anyHealthy.Set true }}
		{{- end }}
		{{- if ne $destPort ""}}
			{{- template "upstream" (dict "HOST" $host "FIRST" $alive "IP" $cont.Address "ONLINE" $online "PORT" $destPort) }}
			{{- $_ := $alive.Set true }}
		{{- else if .Labels.Exists "rap.port"}}
			{{- $port := .Labels.GetValue "rap.port" "80" }}
			{{- if not (isPort $port) }}{{ $port = $default_port }}{{ end }}
			{{- template "upstream" (dict "HOST" $host "FIRST" $alive "IP" $cont.Address "ONLINE" $online "PORT" $port) }}
			{{- $_ := $alive.Set true }}
		{{- else if eq $addrLen 1 }}
			{{- $intport := (first $service.Ports).InternalPort }}
			{{- template "upstream" (dict "HOST" $host "FIRST" $alive "IP" $cont.Address "ONLINE" $online "PORT" $intport) }}
			{{- $_ := $alive.Set true }}
		{{- else }}
			{{- template "upstream" (dict "HOST" $host "FIRST" $alive "IP" $cont.Address "ONLINE" $online "PORT" $default_port) }}
			{{- $_ := $alive.Set true }}
		{{- end }}
{{- end -}}
{{- end -}}
{{- if $alive.Get }}
	{{- if not $anyHealthy.Get }}
		server localhost down;
	{{- end }}
}

{{ template "server" (dict "HOST" $host "FIRST" (first $services)  "PROTO" $destProto) }}

{{ end -}}
{{- end }}

# Standalone containers config

{{ if or (eq $host_filter "*") (eq host.Name $host_filter) }}
{{- range $opt, $conts := host.Containers | filterLabel "rap.rap_name" $rap_name | groupByMultiFilter "" "rap.host" ","}}
{{- $parts := split $opt "=>"}}
{{- $host := first $parts | trim }}
{{- $dest := last $parts | trim }}
{{- $destParts := split (when (ne $host $dest) $dest ":") ":" }}
{{- $destProto := first $destParts }}
{{- $destPort := last $destParts }}
{{- if eq (len $destParts) 1 }}{{ $destProto = "" }}{{ end }}{{/* "host=>8080" means port only */}}
{{- if not (isHostname $host) }}
# skipped rap.host value {{ printf "%q" $host }}: not a valid hostname
{{- continue }}
{{- end }}
{{- if and (ne $destPort "") (not (isPort $destPort)) }}
# skipped rap.host value {{ printf "%q" $opt }}: not a valid port
{{- continue }}
{{- end }}
{{- if not (isSafeToken $destProto) }}{{ $destProto = "" }}{{ end }}
{{- $alive := cell false }}
{{- $anyHealthy := cell false }}

{{ range $cont := $conts }}
{{- $addrLen := len $cont.Ports }}
		{{- $online := (and (or (eq .Health "") (eq .Health "healthy")) (eq .State "running")) -}}
		{{- if $online }}
			{{- $_ := $anyHealthy.Set true }}
		{{- end }}
		{{- if ne $destPort ""}}
			{{- template "upstream" (dict "HOST" $host "FIRST" $alive "IP" $cont.Address "ONLINE" $online "PORT" $destPort) }}
			{{- $_ := $alive.Set true }}
		{{- else if .Labels.Exists "rap.port"}}
			{{- $port := .Labels.GetValue "rap.port" "80" }}
			{{- if not (isPort $port) }}{{ $port = $default_port }}{{ end }}
			{{- template "upstream" (dict "HOST" $host "FIRST" $alive "IP" $cont.Address "ONLINE" $online "PORT" $port) }}
			{{- $_ := $alive.Set true }}
		{{- else if eq $addrLen 1 }}
			{{- $intport := (first $cont.Ports).InternalPort }}
			{{- template "upstream" (dict "HOST" $host "FIRST" $alive "IP" $cont.Address "ONLINE" $online "PORT" $intport ) }}
			{{- $_ := $alive.Set true }}
		{{- else }}
			{{- template "upstream" (dict "HOST" $host "FIRST" $alive "IP" $cont.Address "ONLINE" $online "PORT" $default_port) }}
			{{- $_ := $alive.Set true }}
		{{- end }}
{{- end -}}
{{- if $alive.Get }}
	{{- if not $anyHealthy.Get }}
		server localhost down;
	{{- end }}
}

{{ template "server" (dict "HOST" $host "FIRST" (first $conts)  "PROTO" $destProto) }}

{{ end -}}
{{- end -}}
{{- end -}}
